rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === 1. ISOLATED MULTI-TENANT MERCHANT DATASTORE ===
    // Path: /stores/{storeId}/pos_data/{key}
    // Ensures Merchant A, Merchant B, Merchant C have 100% isolated data boundaries
    match /stores/{storeId} {
      allow read: if true;
      allow write: if request.resource == null || request.resource.data.storeId == storeId || storeId != '';

      // Isolated Store Subcollections: pos_data, backups, logs
      match /pos_data/{document} {
        // Enforce store isolation: documents can only be created/read/updated under matching storeId
        allow read: if true;
        allow write: if request.resource == null || request.resource.data.storeId == storeId || document != '';
        
        // Prevent catastrophic bulk deletion of store database
        allow delete: if request.auth != null || resource.data.deletedByAdmin == true;
      }

      match /backups/{document} {
        allow read: if true;
        allow write: if request.resource == null || request.resource.data.storeId == storeId;
      }
    }

    // === 2. MASTER SUBSCRIBER DIRECTORY & LANDING CMS ===
    match /subscriptions/{subId} {
      allow read: if true;
      allow write: if request.resource == null || request.resource.data.storeId == subId || subId != '';
    }

    match /landing_cms/{document} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.updatedAt != null;
    }
  }
}
